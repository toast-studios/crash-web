{
  "name": "two-plus-one-jack-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prestart": "dotenv -- run-s assets",
    "assets": "dotenv -- assetpack",
    "start": "dotenv -- vite --open",
    "copyLotties": "mkdir -p ./dist/lotties && cp -r ./lotties/* ./dist/lotties",
    "prebuild": "run-s clean format:check lint assets types",
    "build": "npm run format && dotenv -- vite build  && npm run copyLotties",
    "types": "tsc",
    "prepreview": "run-s build",
    "preview": "dotenv -- vite preview --open",
    "clean": "rm -rf public/assets/* dist/* .assetpack/*",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "validate:assets": "node scripts/validate-assets.js",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@node-rs/crc32": "^1.10.4",
    "@pixi/sound": "^6.0.1",
    "@pixi/ui": "^2.1.5",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-typescript": "^12.1.1",
    "@sentry/browser": "^8.33.1",
    "@sentry/vite-plugin": "^3.1.0",
    "axios": "^1.7.7",
    "fontfaceobserver": "^2.3.0",
    "gsap": "^3.12.5",
    "idb": "^8.0.0",
    "jwt-decode": "^4.0.0",
    "lottie-web": "^5.12.2",
    "npm-run-all": "^4.1.5",
    "pixi.js": "^8.3.4",
    "socket.io-client": "^4.7.5",
    "vite": "^5.4.3"
  },
  "devDependencies": {
    "@assetpack/core": "^1.1.1",
    "@eslint/js": "^9.10.0",
    "@sentry/vite-plugin": "^3.0.0",
    "@types/ejs": "^3.1.5",
    "@types/fontfaceobserver": "^2.1.3",
    "css-loader": "^7.1.2",
    "dotenv-cli": "^7.4.2",
    "ejs": "^3.1.10",
    "eslint": "^9.10.0",
    "globals": "^15.9.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^8.0.0",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.4.45",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.3",
    "sass": "^1.78.0",
    "sass-loader": "^16.0.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vite-plugin-ejs": "^1.7.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}

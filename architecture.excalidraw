      "strokeColor": "#862e9c"
    },
    {
      "id": "flow-content",
      "type": "text",
      "x": 60,
      "y": 650,
      "width": 1090,
      "height": 70,
      "text": "Phone Auth → JWT Token → WSS Connect → Join Queue → Redis sorted set → 6 players matched → Deduct $10 bet each\n→ Create GameRoom → 3s Countdown → Game Loop (20Hz tick, 10Hz sync) → Heat rises 0→100%\n→ Players: Cool (-8%) | Boost (+5%) | Exit (lock score) → Heat hits 100% = bust → Rank by exit time → Top 3 share $100 pool → Credit balance → Record match",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#495057"
    },

